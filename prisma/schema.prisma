generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Tier {
  FOUNDATION
  FLOW
  FREEDOM
}

model Level {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  tier      Tier
  color     String
  sortOrder Int
  types     Type[]
  cards     Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Type {
  id        String @id @default(cuid())
  name      String
  slug      String
  sortOrder Int
  levelId   String
  level     Level  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  cards     Card[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([levelId, slug])
}

model Card {
  id        String  @id @default(cuid())
  hebrew    String
  english   String
  sortOrder Int
  levelId   String
  level     Level   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  // null = level has no packs
  typeId    String?
  type      Type?   @relation(fields: [typeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([levelId, typeId])
}
